{
  "schema": 1,
  "id": "key-visualizer",
  "category": "plugins",
  "version": "0.1.0",
  "destination": "ryoku/plugins/key-visualizer",
  "name": "Key Visualizer",
  "author": "Himanshu <manshu3220@gmail.com>",
  "description": "Shows the keys you press on screen with configurable layout, linger, and history.",
  "license": "MIT",
  "tags": [
    "keyboard",
    "keys",
    "overlay",
    "hyprland",
    "topbarGlyph"
  ],
  "official": false,
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "capabilities": {
    "densities": [
      "glyph"
    ]
  },
  "hosts": [
    "topbarGlyph"
  ],
  "defaults": {
    "host": "topbarGlyph",
    "icon": "keyboard",
    "label": "Key Visualizer"
  },
  "metadata": {
    "settings": [
      {
        "key": "paused",
        "type": "toggle",
        "label": "Pause display",
        "group": "General",
        "default": false
      },
      {
        "key": "position",
        "type": "choice",
        "label": "Screen position",
        "group": "Display",
        "default": "bottom-center",
        "options": [
          {
            "value": "bottom-center",
            "label": "Bottom Center"
          },
          {
            "value": "bottom-left",
            "label": "Bottom Left"
          },
          {
            "value": "bottom-right",
            "label": "Bottom Right"
          },
          {
            "value": "top-center",
            "label": "Top Center"
          },
          {
            "value": "top-left",
            "label": "Top Left"
          },
          {
            "value": "top-right",
            "label": "Top Right"
          }
        ]
      },
      {
        "key": "margin",
        "type": "slider",
        "label": "Screen margin (px)",
        "group": "Display",
        "default": 67,
        "min": 10,
        "max": 200,
        "step": 1,
        "decimals": 0
      },
      {
        "key": "lingerMs",
        "type": "slider",
        "label": "Linger duration (ms)",
        "group": "Behavior",
        "default": 1000,
        "min": 0,
        "max": 5000,
        "step": 100,
        "decimals": 0
      },
      {
        "key": "historyCount",
        "type": "slider",
        "label": "History stack count",
        "group": "Behavior",
        "default": 1,
        "min": 1,
        "max": 5,
        "step": 1,
        "decimals": 0
      }
    ]
  },
